# Banco de dados de alunos
bd_alunos = {}

def adicionar_aluno(bd, matricula, nome, curso):
    """
    Adiciona um aluno ao banco de dados.
    Retorna True se o aluno foi adicionado.
    Retorna False se a matrícula já existir.
    """
    if matricula in bd:
        return False

    bd[matricula] = {
        "nome": nome,
        "curso": curso
    }
    return True


def buscar_nome_curso(bd, matricula):
    """
    Retorna uma tupla (nome, curso) do aluno.
    Se a matrícula não existir, retorna (None, None).
    """
    if matricula in bd:
        return (bd[matricula]["nome"], bd[matricula]["curso"])

    return (None, None)


